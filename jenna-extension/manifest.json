{
  "manifest_version": 3,
  "name": "Jenna Bot Pro Captcha Extension",
  "version": "2.1.0",
  "description": "reCAPTCHA Enterprise token generator for Jenna Bot Pro",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js"
      ],
      "matches": [
        "https://labs.google.com/*",
        "https://labs.google/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jenna Captcha Extension",
    "default_icon": "icons/logo.png"
  },
  "icons": {
    "128": "icons/logo.png"
  }
}